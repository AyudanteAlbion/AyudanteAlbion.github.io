#!/bin/sh
# Valida el formato, los nombres de archivo y la hora UTC del mensaje.
set -eu

MSG_FILE=${1:?Falta el archivo del mensaje de commit}
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
PYTHON=${PYTHON:-python3}

exec "$PYTHON" "$ROOT/scripts/validate_commit_messages.py" --message-file "$MSG_FILE" --staged

