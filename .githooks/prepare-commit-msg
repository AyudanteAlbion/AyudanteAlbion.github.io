#!/bin/sh
# Genera el mensaje de commit con el nombre del/los archivo(s) en staging.
MSG_FILE="$1"
SOURCE="$2"

# No tocar merges, squashes, commits con -m/-F, ni amend/template
case "$SOURCE" in
  merge|squash|commit|message) exit 0 ;;
esac

# Si ya hay contenido no comentado, respetarlo
if grep -qvE '^\s*(#.*)?$' "$MSG_FILE" 2>/dev/null; then
  exit 0
fi

FILES=$(git diff --cached --name-only --diff-filter=ACDMRT | xargs -n1 basename 2>/dev/null | sort -u | paste -sd', ' -)
[ -z "$FILES" ] && exit 0

printf '%s\n' "$FILES" > "$MSG_FILE.tmp"
cat "$MSG_FILE" >> "$MSG_FILE.tmp"
mv "$MSG_FILE.tmp" "$MSG_FILE"
