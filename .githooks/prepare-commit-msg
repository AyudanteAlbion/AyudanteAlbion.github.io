#!/bin/sh
# Genera el mensaje de commit con el nombre exacto del/los archivo(s) en staging.
set -eu

MSG_FILE=${1:?Falta el archivo del mensaje de commit}
SOURCE=${2-}
PYTHON=${PYTHON:-python3}

# No tocar merges, squashes, commits con -m/-F ni amend.
case "$SOURCE" in
  merge|squash|commit|message) exit 0 ;;
esac

# Si ya hay contenido no comentado, respetarlo para que commit-msg lo valide.
if grep -qvE '^[[:space:]]*(#.*)?$' "$MSG_FILE" 2>/dev/null; then
  exit 0
fi

# Git entrega las rutas separadas por NUL: así también se manejan espacios y
# caracteres especiales en los nombres. La convención usa el nombre base.
FILES=$(
  git diff --cached --name-only --diff-filter=ACDMRT -z |
    "$PYTHON" -c '
import os
import sys

paths = sys.stdin.buffer.read().split(b"\0")
names = {os.fsdecode(path).rsplit("/", 1)[-1] for path in paths if path}
print(", ".join(sorted(names)))
'
)
[ -n "$FILES" ] || exit 0

# El mensaje es exactamente el nombre del archivo (o los nombres separados
# por coma), sin prefijos, sin hora y sin cuerpo.
TMP_FILE="$MSG_FILE.tmp.$$"
trap 'rm -f "$TMP_FILE"' EXIT HUP INT TERM
{
  printf '%s\n' "$FILES"
  cat "$MSG_FILE"
} > "$TMP_FILE"
mv "$TMP_FILE" "$MSG_FILE"
trap - EXIT HUP INT TERM
